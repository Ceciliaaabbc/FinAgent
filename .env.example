# 复制为 .env 后填写（.env 不会上传 GitHub）
# 老师模型可以是任意 OpenAI 兼容接口，下面三种方案选一种，把对应的行取消注释（删掉行首的 #）

# ===== 方案 A：本地 Ollama（免费，不用注册，推荐先用这个）=====
# 先运行：ollama pull qwen3.5:9b
TEACHER_BASE_URL=http://localhost:11434/v1
TEACHER_API_KEY=ollama
TEACHER_MODEL=qwen3.5:9b
TEACHER_REASONING_EFFORT=none   # 关闭“思考”，否则又慢又会输出空结果
TEACHER_PRICE_IN=0
TEACHER_PRICE_OUT=0

# ===== 方案 B：DeepSeek 官方 API =====
# TEACHER_BASE_URL=https://api.deepseek.com
# TEACHER_API_KEY=sk-...
# TEACHER_MODEL=deepseek-chat
# TEACHER_REASONING_EFFORT=
# TEACHER_PRICE_IN=0             # 元 / 百万输入 tokens，按官网价格填写，用于估算成本
# TEACHER_PRICE_OUT=0            # 元 / 百万输出 tokens

# ===== 方案 C：其他云服务（模型名以服务商的模型列表为准）=====
# 硅基流动：     TEACHER_BASE_URL=https://api.siliconflow.cn/v1
# 阿里云百炼：   TEACHER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenRouter：   TEACHER_BASE_URL=https://openrouter.ai/api/v1

# ===== 学生模型：vLLM 部署的 Qwen（原始或微调后）=====
# 在本地访问云服务器上的 vLLM，可以用 SSH 端口转发：ssh -L 8000:localhost:8000 用户@服务器
STUDENT_BASE_URL=http://localhost:8000/v1
STUDENT_API_KEY=EMPTY
STUDENT_MODEL=sentiment         # 对应 vllm serve 的 --lora-modules sentiment=...
STUDENT_REASONING_EFFORT=
